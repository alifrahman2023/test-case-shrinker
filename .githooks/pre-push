#!/usr/bin/env bash
# Before a push, run the Linux CI checks in Docker against the commit being pushed, so a
# GCC-only warning fails here instead of on GitHub.
#
# Skip once with:  git push --no-verify
set -eo pipefail

repo=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
checked=" "

while read -r local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # deleting a remote branch: nothing to build
  case "$checked" in *" $local_sha "*) continue ;; esac
  checked="$checked$local_sha "

  echo "pre-push: checking $local_ref on Linux. Skip with: git push --no-verify"
  if ! "$repo/scripts/check-linux.sh" --rev "$local_sha" </dev/null; then
    echo "pre-push: Linux checks failed, push aborted." >&2
    exit 1
  fi
done
