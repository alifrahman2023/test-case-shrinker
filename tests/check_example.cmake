file(MAKE_DIRECTORY "${CHECK_DIRECTORY}/examples/${CASE}" "${CHECK_DIRECTORY}/elsewhere")
set(example "${CHECK_DIRECTORY}/examples/${CASE}")
foreach(name original.txt solution reference run.sh)
    if(NOT EXISTS "${EXAMPLE_DIRECTORY}/${name}")
        message(FATAL_ERROR "Example is missing ${name}")
    endif()
    file(COPY "${EXAMPLE_DIRECTORY}/${name}" DESTINATION "${example}")
endforeach()
file(COPY "${EXAMPLE_DIRECTORY}/../find-shrink.sh" DESTINATION "${CHECK_DIRECTORY}/examples")

set(min_length 0)
set(max_length 10)
set(min_value -100)
set(max_value 100)
set(original_solution 4)
set(original_reference 3)
if(CASE STREQUAL "width")
    set(min_length 2)
    set(max_length 2)
    set(min_value 0)
    set(max_value 100000)
    set(original_solution 1410065408)
    set(original_reference 10000000000)
elseif(CASE STREQUAL "maximum")
    set(min_length 1)
    set(max_length 8)
    set(original_solution 0)
    set(original_reference -3)
elseif(CASE STREQUAL "sum-last")
    set(max_length 8)
    set(original_solution 13)
    set(original_reference 10)
elseif(CASE STREQUAL "lower-median")
    set(min_length 1)
    set(max_length 8)
    set(original_solution 3)
    set(original_reference 1)
endif()

function(check_input input)
    file(READ "${input}" text)
    string(REGEX MATCHALL "-?[0-9]+" values "${text}")
    list(POP_FRONT values length)
    list(LENGTH values actual_length)
    list(JOIN values " " value_line)
    if(NOT text STREQUAL "${length}\n${value_line}\n" OR NOT length EQUAL actual_length
       OR length LESS min_length OR length GREATER max_length)
        message(FATAL_ERROR "Invalid example input: ${text}")
    endif()
    foreach(value IN LISTS values)
        if(NOT value MATCHES "^(0|-?[1-9][0-9]*)$" OR value LESS min_value OR value GREATER max_value)
            message(FATAL_ERROR "Value violates example constraints: ${value}")
        endif()
    endforeach()
    # The mathematical answer is independent of shrink and the supplied reference.
    if(CASE STREQUAL "width")
        list(GET values 0 first)
        list(GET values 1 second)
        math(EXPR answer "${first} * ${second}")
    elseif(CASE STREQUAL "maximum")
        set(answer -100)
        foreach(value IN LISTS values)
            if(value GREATER answer)
                set(answer "${value}")
            endif()
        endforeach()
    elseif(CASE STREQUAL "sum-last")
        set(answer 0)
        foreach(value IN LISTS values)
            math(EXPR answer "${answer} + ${value}")
        endforeach()
    elseif(CASE STREQUAL "lower-median")
        set(previous -100)
        foreach(value IN LISTS values)
            if(value LESS previous)
                message(FATAL_ERROR "Median input is not sorted ascending")
            endif()
            set(previous "${value}")
        endforeach()
        math(EXPR middle "(${length} - 1) / 2")
        list(GET values ${middle} answer)
    else()
        list(REMOVE_DUPLICATES values)
        list(LENGTH values answer)
    endif()
    set(expected_reference "${answer}" PARENT_SCOPE)
endfunction()

function(check_answers input expected_solution)
    check_input("${input}")
    foreach(program "${example}/solution" "${example}/reference" "${NATIVE_SOLUTION}" "${NATIVE_REFERENCE}")
        execute_process(COMMAND "${program}" INPUT_FILE "${input}"
            RESULT_VARIABLE status OUTPUT_VARIABLE answer ERROR_VARIABLE errors TIMEOUT 5)
        if(NOT "${status}" STREQUAL "0" OR NOT errors STREQUAL "")
            message(FATAL_ERROR "Example program failed: ${program}: ${status}: ${errors}")
        endif()
        if(program STREQUAL "${example}/reference" OR program STREQUAL NATIVE_REFERENCE)
            if(NOT answer STREQUAL "${expected_reference}\n")
                message(FATAL_ERROR "Reference disagrees with independent answer: ${answer}")
            endif()
        elseif(answer STREQUAL "${expected_reference}\n")
            message(FATAL_ERROR "Solution no longer demonstrates a wrong answer")
        elseif(NOT expected_solution STREQUAL "" AND NOT answer STREQUAL "${expected_solution}\n")
            message(FATAL_ERROR "Original solution answer differs from documentation: ${answer}")
        endif()
    endforeach()
endfunction()

check_input("${example}/original.txt")
if(NOT expected_reference STREQUAL original_reference)
    message(FATAL_ERROR "Original reference answer differs from documentation")
endif()
# Exercise default and explicit output paths from a different working directory.
# Run the script before directly executing binaries, retaining cold-start coverage.
foreach(destination "${example}/reduced.txt" "${CHECK_DIRECTORY}/result with spaces.txt")
    set(arguments)
    if(NOT destination STREQUAL "${example}/reduced.txt")
        list(APPEND arguments "${destination}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "SHRINK_BIN=${SHRINK_EXECUTABLE}"
        "${example}/run.sh" ${arguments}
        WORKING_DIRECTORY "${CHECK_DIRECTORY}/elsewhere"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE evidence TIMEOUT 20)
    if(NOT "${status}" STREQUAL "0" OR NOT output STREQUAL ""
       OR NOT evidence MATCHES "Stopped: completed." OR NOT evidence MATCHES "Final save: succeeded")
        message(FATAL_ERROR "Example script failed (${status}): ${output}${evidence}")
    endif()
    file(WRITE "${destination}.evidence.txt" "${evidence}")
    check_answers("${destination}" "")
    file(READ "${destination}" reduced)
    file(READ "${example}/original.txt" original)
    if(reduced STREQUAL original)
        message(FATAL_ERROR "Example did not simplify its original input")
    endif()
endforeach()
check_answers("${example}/original.txt" "${original_solution}")
